{
  "name": "waselni-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0",
    "dev:customer": "vite --host 0.0.0.0 --mode customer",
    "dev:captain": "vite --host 0.0.0.0 --mode captain",
    "dev:merchant": "vite --host 0.0.0.0 --mode merchant",
    "dev:admin": "vite --host 0.0.0.0 --mode admin",
    "build:customer": "vite build --configLoader native --mode customer",
    "build:captain": "vite build --configLoader native --mode captain",
    "build:merchant": "vite build --configLoader native --mode merchant",
    "build:admin": "vite build --configLoader native --mode admin",
    "build:all-portals": "npm run build:customer && npm run build:captain && npm run build:merchant && npm run build:admin",
    "cap:customer:sync": "npm --prefix native/customer run sync:android",
    "cap:captain:sync": "npm --prefix native/captain run sync:android",
    "cap:merchant:sync": "npm --prefix native/merchant run sync:android",
    "cap:customer:add:android": "npm --prefix native/customer run add:android",
    "cap:customer:add:ios": "npm --prefix native/customer run add:ios",
    "cap:captain:add:android": "npm --prefix native/captain run add:android",
    "cap:captain:add:ios": "npm --prefix native/captain run add:ios",
    "cap:merchant:add:android": "npm --prefix native/merchant run add:android",
    "cap:merchant:add:ios": "npm --prefix native/merchant run add:ios",
    "cap:customer:sync:ios": "npm --prefix native/customer run sync:ios",
    "cap:captain:sync:ios": "npm --prefix native/captain run sync:ios",
    "cap:merchant:sync:ios": "npm --prefix native/merchant run sync:ios",
    "cap:customer:open:android": "npm --prefix native/customer run open:android",
    "cap:customer:open:ios": "npm --prefix native/customer run open:ios",
    "cap:captain:open:android": "npm --prefix native/captain run open:android",
    "cap:captain:open:ios": "npm --prefix native/captain run open:ios",
    "cap:merchant:open:android": "npm --prefix native/merchant run open:android",
    "cap:merchant:open:ios": "npm --prefix native/merchant run open:ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@vitejs/plugin-react": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
